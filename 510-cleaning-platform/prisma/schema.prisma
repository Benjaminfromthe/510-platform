generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  phone String
  role  UserRole
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  duration    Int
  category    ServiceCategory
  imageUrl    String
}

enum ServiceCategory {
  ELECTRONICS
  FURNITURE
  OTHER
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        String?
  serviceId     Int
  quantity      Int           @default(1)
  addOns        Json?
  customerName  String?
  phone         String?
  email         String?
  staffId       Int?
  scheduledDate DateTime
  scheduledTime DateTime
  status        BookingStatus
  address       String
  notes         String?
  totalPrice    Float
  createdAt     DateTime      @default(now())
  staff         Staff?        @relation(fields: [staffId], references: [id])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Staff {
  id       Int       @id @default(autoincrement())
  userId   Int
  bookings Booking[]
}

model Payment {
  id        Int     @id @default(autoincrement())
  bookingId Int
  amount    Float
  status    String
  method    String
}