generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  phone String
  role  UserRole
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  duration    Int
  category    ServiceCategory
  imageUrl    String
}

enum ServiceCategory {
  ELECTRONICS
  FURNITURE
  OTHER
}

model Booking {
  id              Int           @id @default(autoincrement())
  userId          String?
  serviceId       Int
  quantity        Int           @default(1)
  addOns          Json?
  customerName    String?
  phone           String?
  email           String?
  staffId         Int?
  scheduledDate   DateTime
  scheduledTime   DateTime
  status          BookingStatus
  address         String
  notes           String?
  quoteDescription String
  propertySize    String
  urgency         String
  totalPrice      Float?
  quotedPrice     Float?
  createdAt       DateTime      @default(now())
  staff           Staff?        @relation(fields: [staffId], references: [id])
}

enum BookingStatus {
  PENDING
  PENDING_QUOTE
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Staff {
  id       Int       @id @default(autoincrement())
  userId   Int
  bookings Booking[]
}

model Subscription {
  id               Int               @id @default(autoincrement())
  userId           String
  plan             SubscriptionPlan
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime          @default(now())
  nextCleaningDate DateTime
  totalCleanings   Int
  cleaningsUsed    Int               @default(0)
  createdAt        DateTime          @default(now())
}

enum SubscriptionPlan {
  WEEKLY
  MONTHLY
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Payment {
  id        Int     @id @default(autoincrement())
  bookingId Int
  amount    Float
  status    String
  method    String
}
